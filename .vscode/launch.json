{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug quic-tcp-coexistence",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/scratch/quic-tcp-coexistence",
            "args": ["--nCubic=4", "--nBbr=0", "--nQuic=0", "--tag=pure_cubic"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}